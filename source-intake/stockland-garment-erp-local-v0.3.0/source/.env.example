# Copy this file to .env and set a unique secret before network deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/stockland.sqlite
SESSION_TTL_HOURS=12
# Required for production mode. Generate a long random value and keep it private.
APP_SECRET=
# Optional bootstrap owner, only used by the interactive `npm run bootstrap` command.
