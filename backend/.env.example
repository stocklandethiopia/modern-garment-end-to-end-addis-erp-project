APP_NAME="Modern Garment Addis ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=garment_erp
DB_USERNAME=app_runtime
DB_PASSWORD=local-runtime-password
DB_SEARCH_PATH=public
DB_SSLMODE=prefer
MIGRATION_DB_USERNAME=erp_migrator
MIGRATION_DB_PASSWORD=local-migrator-password
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=local-postgres-password

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200
