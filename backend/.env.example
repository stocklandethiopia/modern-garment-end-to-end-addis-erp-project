APP_NAME="Modern Garment Addis ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.example.invalid
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=garment_erp
DB_USERNAME=app_runtime
DB_PASSWORD=
DB_SEARCH_PATH=public

# Restricted migration/provisioning connection; do not use for HTTP requests.
MIGRATION_DB_USERNAME=erp_migrator
MIGRATION_DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
REDIS_CLIENT=predis
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

SANCTUM_STATEFUL_DOMAINS=app.example.invalid

# Tenant invitation delivery; configure an approved mail transport for real email.
FRONTEND_URL=https://app.example.invalid
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Modern Garment Addis ERP"
