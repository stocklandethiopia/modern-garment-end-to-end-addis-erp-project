APP_NAME="Modern Garment Addis ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=garment_erp
DB_USERNAME=app_runtime
DB_PASSWORD=local-runtime-password
DB_SEARCH_PATH=public

# Restricted migration/provisioning connection; do not use for HTTP requests.
MIGRATION_DB_USERNAME=erp_migrator
MIGRATION_DB_PASSWORD=local-migrator-password
DB_SSLMODE=prefer

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
REDIS_CLIENT=predis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

SANCTUM_STATEFUL_DOMAINS=localhost:4200

# Local private document storage; select another configured Laravel disk per environment.
PRIVATE_DOCUMENTS_DISK=local

# Tenant invitation delivery; configure an approved mail transport for real email.
FRONTEND_URL=http://localhost:4200
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Modern Garment Addis ERP"
